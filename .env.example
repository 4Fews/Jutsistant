# Salin file ini menjadi ".env" (di folder yang sama), lalu isi nilainya.
# File .env sudah diabaikan git, jadi kuncinya tidak akan ikut ter-push.

# Project URL, bentuknya https://<kode-project>.supabase.co
# Supabase Dashboard → tombol "Connect" di bagian atas project.
VITE_SUPABASE_URL=

# Publishable key (diawali "sb_publishable_") — atau legacy "anon" key.
# Kunci ini memang dirancang untuk frontend: datanya dilindungi Row Level Security.
# JANGAN PERNAH isi dengan secret key ("sb_secret_...") atau "service_role" key.
VITE_SUPABASE_ANON_KEY=
